# Production settings for deploy/compose.yaml. Copy to deploy/.env.
# Generate secrets with: openssl rand -base64 32

# ─── Domains ─────────────────────────────────────────────────────────────────
# Both must point (A/AAAA records) at this server; Caddy gets the certificates.
SITE_DOMAIN=moetsukita.xyz
FILES_DOMAIN=files.moetsukita.xyz
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
BACKUP_KEEP_DAYS=14

# ─── File storage (RustFS) ───────────────────────────────────────────────────
STORAGE_ACCESS_KEY=moetsukita
STORAGE_SECRET_KEY=
S3_BUCKET=moetsukita
S3_PUBLIC_BUCKET=moetsukita-public

# ─── Sign-in (Auth.js) ───────────────────────────────────────────────────────
# Random secret for session cookies: openssl rand -base64 32
AUTH_SECRET=
# Discord application (https://discord.com/developers/applications), OAuth2 redirect:
#   https://<SITE_DOMAIN>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Patreon client (https://www.patreon.com/portal/registration/register-clients), redirect URI:
#   https://<SITE_DOMAIN>/api/auth/callback/patreon
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
# Discord user ids that are always admins, comma-separated.
OWNER_DISCORD_IDS=

# ─── Tiers from Discord roles (Fanbox plans) ─────────────────────────────────
# Bot of the same Discord application, invited to the server (no permissions or
# privileged intents needed). Server id: Developer Mode → right-click the server → Copy ID.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ─── Tiers from Patreon pledges ──────────────────────────────────────────────
PATREON_CAMPAIGN_ID=
# Creator's access token from the client page: scheduled sync and the tier list.
PATREON_CREATOR_ACCESS_TOKEN=
# Webhook (members:create/update/delete, members:pledge:*) pointing at
#   https://<SITE_DOMAIN>/api/webhooks/patreon
PATREON_WEBHOOK_SECRET=
# How often the scheduler re-checks everyone, in hours.
ACCESS_SYNC_HOURS=12

# ─── Added in later stages ───────────────────────────────────────────────────
# WATERMARK_SECRET=
