# Local development (`npm run dev`). Copy to .env.local.
# Production uses deploy/.env instead — see deploy/.env.example.

# ─── Database: Postgres from compose.yaml ───────────────────────────────────
DATABASE_URL=postgres://moetsukita:moetsukita@localhost:5432/moetsukita

# ─── Storage: RustFS (S3-compatible) from compose.yaml ──────────────────────
# Where the app reaches storage, and where browsers do (the same locally).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=moetsukita
S3_SECRET_ACCESS_KEY=moetsukita-secret
# Private bucket: originals, previews, watermarked copies.
S3_BUCKET=moetsukita
# Public bucket: blurred previews only.
S3_PUBLIC_BUCKET=moetsukita-public
# Origins allowed to upload from the browser, applied by `npm run storage:setup`.
S3_CORS_ORIGINS=http://localhost:3000

