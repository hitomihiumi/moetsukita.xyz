# Local development (`npm run dev`). Copy to .env.local.
# Production uses deploy/.env instead — see deploy/.env.example.

# ─── Database: Postgres from compose.yaml ───────────────────────────────────
DATABASE_URL=postgres://moetsukita:moetsukita@localhost:5432/moetsukita

# ─── Storage: RustFS (S3-compatible) from compose.yaml ──────────────────────
# Where the app reaches storage, and where browsers do (the same locally).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=moetsukita
S3_SECRET_ACCESS_KEY=moetsukita-secret
# Private bucket: originals, previews, watermarked copies.
S3_BUCKET=moetsukita
# Public bucket: blurred previews only.
S3_PUBLIC_BUCKET=moetsukita-public
# Origins allowed to upload from the browser, applied by `npm run storage:setup`.
S3_CORS_ORIGINS=http://localhost:3000

# ─── Sign-in (Auth.js) ───────────────────────────────────────────────────────
# Random secret for session cookies: openssl rand -base64 32
AUTH_SECRET=
# Discord application (https://discord.com/developers/applications):
# OAuth2 redirect http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Patreon client (https://www.patreon.com/portal/registration/register-clients):
# redirect URI http://localhost:3000/api/auth/callback/patreon
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
# Discord user ids that are always admins, comma-separated.
OWNER_DISCORD_IDS=

# ─── Tiers from Discord roles (Fanbox plans) ─────────────────────────────────
# Bot of the same application, added to the server; no privileged intents needed.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ─── Tiers from Patreon pledges ──────────────────────────────────────────────
PATREON_CAMPAIGN_ID=
# Creator's access token (client page in the Patreon portal): scheduled sync and tier list.
PATREON_CREATOR_ACCESS_TOKEN=
# Secret of the webhook pointing at /api/webhooks/patreon.
PATREON_WEBHOOK_SECRET=

# ─── Added in later stages ───────────────────────────────────────────────────
# WATERMARK_SECRET=
