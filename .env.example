# Copy to .env.local. Local values match compose.yaml.

DATABASE_URL=postgres://moetsukita:moetsukita@localhost:5432/moetsukita

# S3-compatible storage. R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=moetsukita
S3_SECRET_ACCESS_KEY=moetsukita-secret
S3_BUCKET=moetsukita
# Blurred previews only. On R2, set S3_PUBLIC_BASE_URL to the bucket's custom domain.
S3_PUBLIC_BUCKET=moetsukita-public
S3_PUBLIC_BASE_URL=
S3_CORS_ORIGINS=http://localhost:3000

# openssl rand -base64 32
AUTH_SECRET=
# Redirect: <site>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Redirect: <site>/api/auth/callback/patreon
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
OWNER_DISCORD_IDS=

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

PATREON_CAMPAIGN_ID=
PATREON_CREATOR_ACCESS_TOKEN=
# Webhook: <site>/api/webhooks/patreon
PATREON_WEBHOOK_SECRET=

# Watermark and IP-hash key (openssl rand -base64 32). Changing it makes old watermarks unreadable.
WATERMARK_SECRET=
DOWNLOADS_PER_HOUR=60
DOWNLOADS_PER_DAY=300

# Vercel cron auth
CRON_SECRET=
