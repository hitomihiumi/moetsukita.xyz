# Copy to .env.local and fill in. Never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
# Local: the Postgres from docker-compose.yml. Production: the pooled Neon URL.
DATABASE_URL=postgres://moetsukita:moetsukita@localhost:5432/moetsukita

# ─── Storage (Cloudflare R2, S3 API) ─────────────────────────────────────────
# Production: set R2_ACCOUNT_ID and leave R2_ENDPOINT empty.
# Local: RustFS from docker-compose.yml, which needs path-style URLs.
R2_ACCOUNT_ID=
R2_ENDPOINT=http://localhost:9000
R2_FORCE_PATH_STYLE=true
R2_ACCESS_KEY_ID=moetsukita
R2_SECRET_ACCESS_KEY=moetsukita-secret
# Private bucket: originals, previews, watermarked copies.
R2_BUCKET=moetsukita
# Public bucket for blurred previews only, and the domain that serves it.
R2_PUBLIC_BUCKET=moetsukita-public
R2_PUBLIC_BASE_URL=http://localhost:9000/moetsukita-public
# Origins allowed to upload from the browser (comma-separated), applied by `npm run storage:setup`.
STORAGE_CORS_ORIGINS=http://localhost:3000

